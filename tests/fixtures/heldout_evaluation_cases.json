{
  "version": "1.0.0",
  "description": "Independently curated held-out evaluation dataset for Phase 8.1 LLM Query Understanding (20 cases)",
  "cases": [
    {
      "test_id": "HELD001",
      "query": "Logitech wireless gaming mouse under 2500 rs",
      "category": "Computers",
      "description": "Standard brand, product_type, strict max price, soft preference for gaming",
      "expected": {
        "product_type": "gaming mouse",
        "semantic_query": "Logitech wireless gaming mouse",
        "hard_constraints": {
          "category": "Computers",
          "brand": "Logitech",
          "min_price": null,
          "max_price": 2500.0,
          "min_inclusive": true,
          "max_inclusive": false,
          "min_rating": null,
          "currency": "INR"
        },
        "exclusions": [],
        "soft_preferences": ["wireless"],
        "needs_clarification": false
      }
    },
