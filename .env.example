# ==============================================================================
# ShopAssist Environment Configuration Template
# Copy this file to .env and populate with your credentials.
# NEVER commit .env to version control!
# ==============================================================================

# Database Configuration (Supabase PostgreSQL + pgvector)
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# LLM Provider Configuration (Phase 8 - Google Gemini API)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.0
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3

# ==============================================================================
# Phase 12 — Grounded Recommendation (OpenRouter API default, Groq optional)
# ==============================================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
# GROQ_API_KEY=your_groq_api_key_here

PHASE12_LLM_PROVIDER=openrouter
PHASE12_LLM_MODEL=google/gemma-4-26b-a4b-it:free

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=https://github.com/HungVi2907/ShopAssist
# OPENROUTER_APP_TITLE=ShopAssist

PHASE12_LLM_TIMEOUT_SECONDS=30
PHASE12_LLM_MAX_COMPLETION_TOKENS=4096
PHASE12_LLM_MAX_RETRIES=3

PHASE12_TOP_K=5
PHASE12_OUTPUT_LANGUAGE=auto

# ==============================================================================
# Phase 15 — FastAPI Backend Configuration
# ==============================================================================
API_HOST=127.0.0.1
API_PORT=8000
API_LOG_LEVEL=INFO
API_DEFAULT_TOP_K=5
API_MAX_TOP_K=20
API_RETRIEVAL_TOP_N=20
API_RERANKING_METHOD=RRF
API_REQUEST_TIMEOUT_SECONDS=90
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
API_SESSION_TTL_SECONDS=3600
API_SESSION_MAX_MESSAGES=10

# ==============================================================================
# Phase 16 — Telegram Bot Configuration
# ==============================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
SHOPASSIST_API_URL=http://127.0.0.1:8000
BOT_REQUEST_TIMEOUT_SECONDS=95.0
BOT_DEFAULT_TOP_K=5
BOT_DEFAULT_LANGUAGE=auto
BOT_LOG_LEVEL=INFO
